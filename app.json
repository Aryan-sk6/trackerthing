{
  "expo": {
    "name": "SchoolRide",
    "slug": "school-ride-tracker",
    "scheme": "schoolride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#23306B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.schoolride.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SchoolRide uses the camera to scan student ID cards.",
        "NSLocationWhenInUseUsageDescription": "SchoolRide shares this phone's location with parents while a trip is running."
      }
    },
    "android": {
      "package": "in.schoolride.app",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#23306B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SchoolRide to use the camera to scan student ID cards."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#23306B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SchoolRide shares this phone's location with parents while a trip is running."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
