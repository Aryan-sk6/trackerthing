# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are public
# client keys, never secrets). The rest are read only at build time by app.config.ts.

# Supabase project (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (Project → API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Country code pre-filled on the login screen; users can change it.
EXPO_PUBLIC_DEFAULT_DIAL_CODE=+1

# Links shown in Settings and on the paywall. Rows are hidden when a value is empty.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=mailto:support@example.com

# Build-time only
APP_NAME=SchoolRide
APP_BUNDLE_ID=com.example.schoolride
EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_API_KEY=
